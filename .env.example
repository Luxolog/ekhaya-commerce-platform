# Public browser configuration (set per environment in Vercel; values are public by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side integration settings. Never commit real credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MARKETING_MODEL=gpt-4o-mini
APP_ORIGIN=
APP_BASE_URL=

# Optional future email provider configuration. Sending remains disabled until explicitly approved.
MARKETING_EMAIL_PROVIDER=
MARKETING_EMAIL_API_KEY=
MARKETING_EMAIL_FROM=
MARKETING_EMAIL_SEND_ENABLED=false
MARKETING_EMAIL_TEST_MODE=true
MARKETING_EMAIL_TEST_RECIPIENT=

# Automation worker: use a long random secret; never expose it to browser code.
MARKETING_AUTOMATION_WORKER_SECRET=

# Paystack marketing checkout remains disabled pending merchant approval.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_MARKETING_CHECKOUT_ENABLED=false

NEXT_PUBLIC_APP_URL=
