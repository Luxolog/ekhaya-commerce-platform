# Ekhaya Technologies security baseline
# Never commit secrets, credentials, private keys, personal data or generated files.

# Environment and local configuration
.env
.env.*
!.env.example
!.env.*.example
*.local
*.local.*
config.local.*
wp-config.php
wp-config-local.php

# Credentials, tokens and private keys
secrets/
credentials/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519
*service-account*.json
credentials.json
secrets.json
token.json
auth.json
*.jks
*.keystore

# Customer, personal and confidential data
private-data/
personal-data/
customer-data/
customer-exports/
customer-export*
*-customer-export*
*.pii
*.dump
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Database backups and archives
backups/
db-backups/
database-backups/
*.bak
*.backup
*.sql
*.sql.gz
*.dump.gz

# Logs and diagnostics
logs/
*.log
debug.log
error.log

# Dependencies and build output
node_modules/
vendor/
.next/
.nuxt/
.output/
out/
dist/
build/
coverage/

# Local tooling state
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.vercel/
.netlify/
.terraform/
*.tfstate
*.tfstate.*

# Temporary files and caches
tmp/
temp/
.cache/
